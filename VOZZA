    <button onclick="setMainTab('voice')" id="main-voice" class="flex-1 py-2 rounded-full bg-[#2a2010] text-sm">🎤 Voice/Reel + Link — 30s Reel</button>
  </div>
</div>

<!-- BUY TAB — FIRST FEATURE — Stock 5 + Protected 90/10 + Buy -->
<div id="buyTab">
  <!-- Sell Box — Post product — Stock 5 -->
  <div class="voz-card m-3 p-3 rounded-2xl">
    <h3 class="font-bold text-sm mb-2">Sell — Post product — Stock 5 — First Feature</h3>
