<!-- VOICE/REEL TAB — 30s Reel + Link -->
<div id="voiceTab" class="hidden">
  <!-- POST BOX Voice -->
  <div class="voz-card m-3 p-3 rounded-2xl flex gap-2">
    <img id="myAvatar" src="https://i.pravatar.cc/100?img=12" class="w-8 h-8 rounded-full">
    <button onclick="openComposer()" class="flex-1 bg-[#2a2010] text-left px-4 py-2 rounded-full text-sm text-gray-400">What's your voice? + 30s Reel + Link</button>
