      <button class="effect px-3 py-1 rounded-full border border-[#FF6A00] text-xs" data-eff="bass">Bass Boost</button>
      <button class="effect px-3 py-1 rounded-full border border-[#FF6A00] text-xs" data-eff="studio">Studio</button>
    </div>

    <p class="text-xs mb-2">Pictures (<span id="picCount">0</span>/8) <button onclick="document.getElementById('pics').click()" class="float-right bg-green-900 px-3 py-1 rounded-full text-[10px]">+ Add 8 pics</button></p>
    <input id="pics" type="file" multiple accept="image/*" hidden onchange="handlePics(this)">
    <div id="picPreview" class="flex gap-2 overflow-x-auto mb-3"></div>

    <textarea id="caption" placeholder="Say something... #comedy #news — Optional — Post anyway works — If you paste Product ID above — reel/voice get Buy Link — First feature + Link" class="w-full bg-[#2a2010] rounded-xl p-3 text-sm min-h-[80px]"></textarea>

    <div class="flex justify-between items-center mt-3 bg-[#2a2010] p-2 rounded-full text-xs"><span>📶 Data Saver - 3G mode</span><input type="checkbox" checked></div>
    <button onclick="postVoice()" id="postBtn" class="w-full voz-orange py-3 rounded-full font-bold mt-3">Post voice + Reel 30s + Link — First feature Buy + Link same</button>
    <p class="text-center text-[10px] mt-2 text-gray-500">Buy Stock 5 + Voice 60s + Reel 30s + Link — Same product_id — Link vs Buy same — Firebase + Cloudinary + Supabase</p>
  </div>
</div>

<!-- AUTH MODAL -->
<div id="authModal" class="fixed inset-0 bg-black/80 z-[100] hidden flex items-center justify-center p-4">
  <div class="bg-[#1E150A] p-5 rounded-2xl w-full max-w-sm">
    <h2 class="font-bold text-xl mb-3">Sign up - Earn gifts 🎁</h2>
    <input id="authEmail" placeholder="Email" class="w-full bg-[#2a2010] p-2 rounded mb-2 text-sm">
    <input id="authPass" type="password" placeholder="Password" class="w-full bg-[#2a2010] p-2 rounded mb-2 text-sm">
    <input id="authName" placeholder="Name + Bio (optional)" class="w-full bg-[#2a2010] p-2 rounded mb-3 text-sm">
    <button onclick="doAuth()" class="w-full voz-orange py-2 rounded-full font-bold">Sign Up / Sign In</button>
    <button onclick="closeAuth()" class="w-full mt-2 text-sm text-gray-400">Continue without sign in (view only)</button>
