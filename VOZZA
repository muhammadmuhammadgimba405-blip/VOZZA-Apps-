    body: JSON.stringify({ amount, email, metadata, currency:'NGN', callback_url:`${process.env.NEXT_PUBLIC_APP_URL}/?order=${metadata.orderId}` })
  });
  const data = await r.json();
  if(!data.status) return res.status(400).json(data);
  await db.collection('orders').doc(metadata.orderId).update({paystackRef:data.data.reference});
  return res.json({authorization_url:data.data.authorization_url, reference:data.data.reference});
}

