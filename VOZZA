</div>

<!-- BOTTOM NAV -->
<div class="fixed bottom-0 left-0 right-0 bg-[#1E150A] border-t border-[#2a2010] flex justify-around items-center p-2 max-w-[500px] mx-auto">
  <button onclick="setMainTab('buy')" class="text-center">🛒<p class="text-[10px]">Buy — First</p></button>
  <button onclick="setMainTab('voice')">🔥<p class="text-[10px]">Reel+Link</p></button>
  <button onclick="openComposer()" class="w-14 h-14 voz-orange rounded-full -mt-6 text-2xl">🎙️</button>
  <button>🔔<p class="text-[10px]">Alerts</p></button>
  <button onclick="openSettings()">⚙️<p class="text-[10px]">Me</p></button>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, query, orderBy, serverTimestamp, doc, updateDoc, increment } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

// FIREBASE vozza-45dd8
const firebaseConfig = {
  apiKey: "AIzaSyDQyYOcTTjt3CQakJM2Mweh7-rnbEfvhKU",
  authDomain: "vozza-45dd8.firebaseapp.com",
  projectId: "vozza-45dd8",
  storageBucket: "vozza-45dd8.firebasestorage.app",
  messagingSenderId: "379168052667",
  appId: "1:379168052667:web:420370ff83cadeb88c609e"
};
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const auth = getAuth(app);

// CLOUDINARY kosm2eub
const CLOUDINARY_CLOUD = "kosm2eub";
const CLOUDINARY_PRESET = "vozza_app";
const CLOUDINARY_URL = `https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD}/image/upload`;

// SUPABASE FOR BUY FIRST FEATURE — Replace with your Supabase URL + ANON KEY — $0 free
const SUPABASE_URL = "https://YOUR_SUPABASE_URL.supabase.co";
const SUPABASE_ANON = "YOUR_SUPABASE_ANON_KEY";
const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON);

let rec=null, chunks=[], secs=0, timerInt=null, mediaRec=null, currentEff=null, selectedPics=[], selectedPicsUrls=[], currentUser=null, isCommentMode=false, reelFile=null, reelUrl=null;

window.setMainTab = (t)=>{
  document.getElementById('buyTab').classList.toggle('hidden', t!=='buy');
  document.getElementById('voiceTab').classList.toggle('hidden', t!=='voice');
  document.getElementById('main-buy').className = t==='buy' ? "flex-1 py-2 rounded-full bg-[#FF6A00] text-sm font-bold" : "flex-1 py-2 rounded-full bg-[#2a2010] text-sm";
  document.getElementById('main-voice').className = t==='voice' ? "flex-1 py-2 rounded-full bg-[#FF6A00] text-sm font-bold" : "flex-1 py-2 rounded-full bg-[#2a2010] text-sm";
  if(t==='buy') loadBuyProducts(); else loadFeed();
}

window.openComposer = ()=>{ document.getElementById('composer').classList.remove('hidden'); isCommentMode=false; document.getElementById('timer').innerText="0:00 / 0:60 Voice + 0:30 Reel"; }
window.closeComposer = ()=>{ stopRec(); document.getElementById('composer').classList.add('hidden'); }
window.stopAndNext = ()=>{ stopRec(); alert('Stopped! You can move next without finishing - post anyway works!'); }
window.openAuth = ()=> document.getElementById('authModal').classList.remove('hidden');
window.closeAuth = ()=> document.getElementById('authModal').classList.add('hidden');

onAuthStateChanged(auth, (user)=>{ currentUser=user; if(user) document.getElementById('authBtn').innerText=user.email.split('@')[0]; loadAll(); });

window.doAuth = async ()=>{
  const email=document.getElementById('authEmail').value;
  const pass=document.getElementById('authPass').value;
  if(!email||!pass) return alert('Email & pass needed');
  try{ await createUserWithEmailAndPassword(auth,email,pass); }catch(e){ try{ await signInWithEmailAndPassword(auth,email,pass); }catch(err){ alert(err.message); return; } }
  closeAuth();
}

window.toggleRec = async ()=>{
  if(mediaRec && mediaRec.state==='recording'){ stopRec(); return; }
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:true});
    mediaRec=new MediaRecorder(stream); chunks=[]; secs=0;
    mediaRec.ondataavailable=e=>chunks.push(e.data);
    mediaRec.onstop=()=>{ rec=new Blob(chunks,{type:'audio/webm'}); };
    mediaRec.start();
    document.getElementById('recBtn').innerText='⏹️';
    timerInt=setInterval(()=>{
      secs++; 
      let max = isCommentMode?20:60;
      document.getElementById('timer').innerText=`0:${String(secs).padStart(2,'0')} / 0:${max} Voice + 0:30 Reel — Link ready`;
      document.getElementById('progress').style.width=(secs/max*100)+'%';
      const w=document.createElement('div'); w.className='w-1 bg-[#FF6A00] wave rounded'; w.style.height=Math.random()*20+10+'px'; document.getElementById('waves').appendChild(w);
      if(secs>=max) stopRec();
    },1000);
  }catch(e){ alert('Mic permission needed'); }
}
window.stopRec = ()=>{ if(mediaRec){ mediaRec.stop(); clearInterval(timerInt); document.getElementById('recBtn').innerText='🎙️'; mediaRec.stream.getTracks().forEach(t=>t.stop()); } }

document.querySelectorAll('.effect').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.effect').forEach(x=>x.classList.remove('bg-[#FF6A00]','text-white')); 
  b.classList.add('bg-[#FF6A00]','text-white'); currentEff=b.dataset.eff;
});

document.getElementById('reelVideo').onchange = async (e)=>{
  reelFile=e.target.files[0];
  if(!reelFile) return;
  // Check duration 30s max — test all options — if don't want cancel
  const video = document.createElement('video');
  video.preload='metadata';
  video.onloadedmetadata = ()=>{
    window.URL.revokeObjectURL(video.src);
    if(video.duration>30){
      alert(`Reel ${Math.round(video.duration)}s — max 30s — cancel — if you don't want — test 30s only — please select 30s max`);
      e.target.value=''; reelFile=null; document.getElementById('reelInfo').innerText='❌ Reel too long — max 30s — cancel — select 30s max — test all';
      return;
    }
    document.getElementById('reelInfo').innerText=`✅ Reel ${Math.round(video.duration)}s — OK — 30s max — Link ready — ${reelFile.name} — Ready for upload`;
  };
  video.src=URL.createObjectURL(reelFile);
}

window.handlePics = async (input)=>{
  const files=[...input.files].slice(0,8);
  selectedPics=files;
  document.getElementById('picCount').innerText=files.length;
  const prev=document.getElementById('picPreview'); prev.innerHTML='Uploading to Cloudinary...';
  selectedPicsUrls=[];
  for(let f of files){
    const fd=new FormData(); fd.append('file',f); fd.append('upload_preset',CLOUDINARY_PRESET);
    try{
      const res=await fetch(CLOUDINARY_URL,{method:'POST',body:fd});
      const data=await res.json();
      if(data.secure_url) selectedPicsUrls.push(data.secure_url);
    }catch(e){ selectedPicsUrls.push(URL.createObjectURL(f)); }
  }
  prev.innerHTML=''; selectedPicsUrls.forEach(url=>{ const img=document.createElement('img'); img.src=url; img.className='w-20 h-20 object-cover rounded-lg border-2 border-[#FF6A00]'; prev.appendChild(img); });
}

// FIRST FEATURE — BUY — Post product Stock 5
window.postProduct = async ()=>{
  const title=document.getElementById('buyTitle').value;
  const price=document.getElementById('buyPrice').value;
  const file=document.getElementById('buyImage').files[0];
  if(!title||!price) return alert('Title + Price needed — First feature');
  if(!currentUser) { openAuth(); return alert('Sign up to sell — First feature'); }
  let image_url='';
  if(file){
    const fd=new FormData(); fd.append('file',file); fd.append('upload_preset',CLOUDINARY_PRESET);
    const res=await fetch(CLOUDINARY_URL,{method:'POST',body:fd});
    const data=await res.json(); image_url=data.secure_url;
  }
  try{
    const {data, error}=await supabase.from('products').insert({ seller_id: currentUser.uid, title, price: Number(price), stock:5, initial_stock:5, location:'Onitsha Main Market', image_url, status:'active' }).select().single();
    if(error) throw error;
    alert(`Posted! Stock 5 — Product ID: ${data.id} — Copy this ID — Paste in Voice/Reel Tab LINK box — First feature — Buy + Link same — Product ID for Link: ${data.id}`);
    document.getElementById('buyTitle').value=''; document.getElementById('buyPrice').value='';
    loadBuyProducts();
  }catch(e){
    // Offline fallback
    let offline=JSON.parse(localStorage.getItem('vozza_buy')||'[]');
    offline.unshift({id:'local_'+Date.now(), title, price, image_url, stock:5, initial_stock:5, location:'Onitsha Main Market', created_at:new Date().toISOString()});
    localStorage.setItem('vozza_buy',JSON.stringify(offline));
    alert(`Posted offline! (Supabase not set) — Title: ${title} — Stock 5 — For demo — Product ID local — Set Supabase URL in code — First feature — Copy ID for Link test`);
    loadBuyProducts();
  }
}

window.loadBuyProducts = async ()=>{
  const container=document.getElementById('buyFeed');
  container.innerHTML='<p class="text-center py-4">Loading Buy — First feature — Stock 5...</p>';
  try{
    const {data}=await supabase.from('products').select('*').eq('status','active').order('created_at',{ascending:false}).limit(20);
    if(data && data.length>0){
      container.innerHTML=data.map(p=>`
        <div class="voz-card m-3 rounded-2xl overflow-hidden">
          <img src="${p.image_url||'https://via.placeholder.com/500x300?text='+encodeURIComponent(p.title)}" class="w-full h-[250px] object-cover">
          <div class="p-3">
            <h3 class="font-bold text-sm">${p.title}</h3>
            <p class="text-[11px] text-gray-400">📍 ${p.location} • ⏰ ${new Date(p.created_at).toLocaleString()} • 📦 ${p.stock}/${p.initial_stock} left • ID: ${p.id.slice(0,8)} — For Link</p>
            <p class="font-black text-xl mt-1">₦${p.price}</p>
            <button onclick="buyProduct('${p.id}','buy_tab')" class="w-full voz-orange py-2 rounded-full font-bold text-sm mt-2">Buy — Direct — First Feature — Protected 90/10 — ₦${p.price} — No Link — Inside Shop</button>
            <p class="text-[9px] text-gray-500 mt-1">Product ID for Link: ${p.id} — Copy — Paste in Voice/Reel Tab LINK box — Link = Buy button inside reel — Same product — Same money — First feature + Link</p>
          </div>
        </div>
      `).join('');
      return;
    }
  }catch(e){}
  // Offline fallback
  const offline=JSON.parse(localStorage.getItem('vozza_buy')||'[]');
  if(offline.length===0){ container.innerHTML=`<div class="text-center py-10 opacity-60"><p class="font-bold">No products yet — First feature — Post your first product — Stock 5</p><p class="text-[10px] mt-2">Set SUPABASE_URL in code — Free — Stock 5 + Protected 90/10</p></div>`; return; }
  container.innerHTML=offline.map(p=>`
    <div class="voz-card m-3 rounded-2xl overflow-hidden">
      <img src="${p.image_url||''}" class="w-full h-[200px] object-cover">
      <div class="p-3"><h3 class="font-bold text-sm">${p.title}</h3><p>₦${p.price} • 📦 ${p.stock}/${p.initial_stock} left • ID: ${p.id}</p><button onclick="buyProduct('${p.id}','buy_tab')" class="w-full voz-orange py-2 rounded-full font-bold text-sm mt-2">Buy — Direct — First Feature — ₦${p.price}</button></div>
    </div>
  `).join('');
}

window.buyProduct = async (productId, source='buy_tab')=>{
  if(!currentUser){ openAuth(); return alert('Sign up to buy — Protected 90/10'); }
  try{
    const {data: orderId, error}=await supabase.rpc('buy_product',{p_product_id:productId, p_buyer_id:currentUser.uid, p_source:source});
    if(error) throw error;
    alert(`Bought! Order ${orderId} — Source: ${source} — Stock 5->4 — Paystack next — Link vs Buy same — ${source==='buy_tab'?'Direct Buy — Inside shop':'Buy via Link — Signboard — Same shop — Same money'}`);
    loadBuyProducts();
  }catch(e){
    alert('Bought! (local demo) — Stock 5->4 — First feature — Buy + Link same — Source: '+source+' — In real app — Paystack — Protected 90/10 — Set Supabase for real');
    loadBuyProducts();
  }
}

window.postVoice = async ()=>{
  const text=document.getElementById('caption').value;
  const linkId=document.getElementById('linkProductId').value.trim(); // LINK — product_id from Buy Tab — Same Buy
  if(!rec && !text && selectedPicsUrls.length===0 && !reelFile) return alert('Add voice OR text OR picture OR reel 30s — need one — Post anyway works — If you add Link Product ID — reel get Buy button — First feature + Link');
  const btn=document.getElementById('postBtn'); btn.innerText='Posting...'; btn.disabled=true;

  let voiceUrl=null, reelUploadUrl=null;
  if(rec){
    const fd=new FormData(); fd.append('file',rec); fd.append('upload_preset',CLOUDINARY_PRESET); fd.append('resource_type','video');
    try{ const r=await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD}/video/upload`,{method:'POST',body:fd}); const d=await r.json(); voiceUrl=d.secure_url; }catch(e){}
  }
  if(reelFile){
    const fd=new FormData(); fd.append('file',reelFile); fd.append('upload_preset',CLOUDINARY_PRESET); fd.append('resource_type','video');
    try{ const r=await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD}/video/upload`,{method:'POST',body:fd}); const d=await r.json(); reelUploadUrl=d.secure_url; }catch(e){ reelUploadUrl=URL.createObjectURL(reelFile); }
  }

  const postData={
    text: text||'',
    voiceUrl: voiceUrl||'',
    reelUrl: reelUploadUrl||'',
    reelDuration: reelFile?30:0,
    voiceDuration: rec?60:0,
    type: reelFile && rec ? 'both' : reelFile ? 'reel' : 'voice',
